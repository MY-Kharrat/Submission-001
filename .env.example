TAVILY_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022
LLM_URL=
INTERNAL_SERVICE_TOKEN=dev-secret-token # shared secret, n8n -> microservices auth

# Server budget sits under the n8n node's 45s client timeout so n8n never
# aborts mid-run while the server keeps burning search/LLM budget.
MAX_SEARCH_ITERATIONS=6
TOTAL_RUN_TIMEOUT_SECONDS=35
PER_CALL_TIMEOUT_SECONDS=8

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
EMBEDDING_MODEL=
