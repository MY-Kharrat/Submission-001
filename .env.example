TAVILY_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022
LLM_URL=
INTERNAL_SERVICE_TOKEN=dev-secret-token # shared secret, n8n -> microservices auth
MAX_SEARCH_ITERATIONS=4
TOTAL_RUN_TIMEOUT_SECONDS=30
PER_CALL_TIMEOUT_SECONDS=8
SUPABASE_URL=
SUPABASE_SERVICE_KEY= # server-side secret key; bypasses RLS, never ship to a client
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2 # must stay 384-dim to match sql/schema.sql
