      "parameters": {
        "jsCode": "const tender = $('1 - Ingest and Normalize Tender').first().json;\nconst research = $json;\nconst requirements = Array.isArray(tender.requirements) ? tender.requirements : [];\n\nconst queryParts = [\n  tender.title,\n  tender.sector,\n  ...requirements,\n  research.sector,\n  ...(research.domain_requirements ?? []),\n  ...(research.past_projects ?? []),\n  ...(research.key_partners ?? []),\n].filter(Boolean);\n\nreturn [{\n  json: {\n    tender,\n    research,\n    rag_query: queryParts.join('. ').slice(0, 10000),\n    config: $('Validate Tender and Configure URLs').first().json.config,\n  },\n}];"
