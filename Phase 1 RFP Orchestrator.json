    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\n\nreturn rows.map((item) => {\n  const row = item.json;\n\n  // Convert a requirements cell into an array.\n  const rawRequirements =\n    row.requirements ??\n    row.Requirements ??\n    row.technical_requirements ??\n    \"\";\n\n  const requirements = Array.isArray(rawRequirements)\n    ? rawRequirements\n    : String(rawRequirements)\n        .split(/\\n|;/)\n        .map((value) => value.trim())\n        .filter(Boolean);\n\n  const title = row.title ?? row.Title ?? \"\";\n  const issuer = row.issuer ?? row.Issuer ?? \"\";\n  const deadline = row.deadline ?? row.Deadline ?? \"\";\n\n  // Prefer an existing description or raw tender text.\n  const rawText =\n    row.raw_text ??\n    row.description ??\n    row.Description ??\n    row.tender_text ??\n    title;\n\n  // Match the usual n8n Webhook output structure:\n  // the incoming request payload is under \"body\".\n  return {\n    json: {\n      body: {\n        title: String(title),\n        issuer: String(issuer),\n        deadline: String(deadline),\n        raw_text: String(rawText),\n        requirements,\n        source: \"simulated_feed\",\n        external_id: String(row.id ?? row.ID ?? \"\")\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        320
      ],
      "id": "025cd9b1-37f6-4727-b55d-ecfc8cd8397b",
      "name": "Normalize Sheet Tender"
    },
    {
      "parameters": {
        "jsCode": "const tender = $('1 - Ingest and Normalize Tender').first().json;\nconst cvs = $json.cv_matches ?? [];\nconst projects = $json.project_matches ?? [];\n\n// Similarity field name depends on your RAG service; these are the common ones.\nconst scoreOf = (m) => Number(m.similarity ?? m.score ?? m.similarity_score ?? 0);\nconst avg = (arr) => arr.length ? arr.reduce((s, m) => s + scoreOf(m), 0) / arr.length : 0;\nconst label = (m) => m.title ?? m.name ?? m.id;\n\n// Average of CV coverage and project coverage, rounded to 2 decimals.\nconst overall = Math.round(((avg(cvs) + avg(projects)) / 2) * 100) / 100;\n\nconst brief =\n  `${tender.title} (${tender.issuer}, deadline ${tender.deadline}). ` +\n  `Matched ${cvs.length} CVs (${cvs.map(label).join(', ') || 'none'}) ` +\n  `and ${projects.length} projects (${projects.map(label).join(', ') || 'none'}).`;\n\nreturn [{\n  json: {\n    tender_title: tender.title,\n    overall_coverage_score: overall,\n    proposal_brief: brief,\n  },\n}];"
      },
