{
  "name": "OliveSoft - Phase 1 RFP Orchestrator",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const request = $json.body ?? $json;\n\n// Single source of truth for all service endpoints.\nconst config = {\n  detectionUrl: 'http://detection:8000',\n  researchUrl: 'http://research:8002',\n  ragUrl: 'http://rag:8001',\n  proposalUrl: 'http://proposal:8003',\n};\n\nconst required = ['title', 'issuer', 'deadline', 'raw_text'];\nfor (const field of required) {\n  if (typeof request[field] !== 'string' || !request[field].trim()) {\n    throw new Error(`Invalid tender: ${field} must be a non-empty string`);\n  }\n}\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(request.deadline) || Number.isNaN(Date.parse(`${request.deadline}T00:00:00Z`))) {\n  throw new Error('Invalid tender: deadline must be a real date in YYYY-MM-DD format');\n}\nif (request.raw_text.length > 20000) {\n  throw new Error('Invalid tender: raw_text exceeds the 20,000 character service limit');\n}\nconst requirements = request.requirements ?? [];\nif (!Array.isArray(requirements) || requirements.some((value) => typeof value !== 'string' || !value.trim())) {\n  throw new Error('Invalid tender: requirements must be an array of non-empty strings');\n}\nconst source = request.source ?? 'manual';\nif (!['manual', 'simulated_feed'].includes(source)) {\n  throw new Error('Invalid tender: source must be manual or simulated_feed');\n}\n\nconst tender = {\n  title: request.title.trim(),\n  issuer: request.issuer.trim(),\n  deadline: request.deadline,\n  raw_text: request.raw_text.trim(),\n  requirements: requirements.map((value) => value.trim()),\n  source,\n};\nif (request.id) tender.id = String(request.id);\nif (request.detected_at) tender.detected_at = String(request.detected_at);\n\nreturn [{ json: { tender, config } }];"
      },
