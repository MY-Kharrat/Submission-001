        "jsCode": "const request = $json.body ?? $json;\n\n// Single source of truth for all service endpoints.\nconst config = {\n  detectionUrl: 'http://detection:8000',\n  researchUrl: 'http://research:8002',\n  ragUrl: 'http://rag:8001',\n  proposalUrl: 'http://proposal:8003'\n};\n\n// Accept either a direct tender object or a wrapped webhook body.\nconst tender = request?.tender ?? request;\n\nif (!tender || !tender.id || !tender.title) {\n  throw new Error('Tender payload missing required id/title fields');\n}\n\nreturn {\n  json: {\n    config,\n    tender\n  }\n};\n"
