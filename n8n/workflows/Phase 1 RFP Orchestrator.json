      "parameters": {
        "jsCode": "const tender = $('1 - Ingest and Normalize Tender').first().json;\nconst research = $json;\nconst requirements = Array.isArray(tender.requirements) ? tender.requirements : [];\nconst requirementTexts = requirements.map((req) => typeof req === 'string' ? req : (req && req.text) || JSON.stringify(req));\nconst tenderText = [\n  tender.title || '',\n  tender.description || '',\n  tender.issuer || '',\n  ...(Array.isArray(tender.categories) ? tender.categories : []),\n  ...requirementTexts\n].filter(Boolean).join('\\n');\n\nconst brief = research && research.brief ? research.brief : '';\nconst entities = research && research.entities ? research.entities : [];\n\nreturn {\n  json: {\n    tender,\n    research,\n    rag_query: `${tenderText}\\n\\n${brief}`.trim(),\n    candidate_entities: entities\n  }\n};\n"
