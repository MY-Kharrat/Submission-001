      "parameters": {
        "jsCode": "\nconst rows = $input.all();\n\nreturn rows.map((item) => {\n  const row = item.json;\n\n  // Convert a requirements cell into an array.\n  const rawRequirements =\n    row.req && typeof row.req === 'string' ? row.req.split(/[,;\\n]+/) : [];\n\n  return {\n    json: {\n      ...row,\n      requirements: rawRequirements.map((r) => r.trim()).filter(Boolean)\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
