      "id": "025cd9b1-37f6-4727-b55d-ecfc8cd8397b",
      "name": "Normalize Sheet Tender"
    },
    {
      "parameters": {
        "jsCode": "const tender = $('1 - Ingest and Normalize Tender').first().json;\nconst cvs = $json.cv_matches ?? [];\nconst projects = $json.project_matches ?? [];\n\n// Similarity field names and candidate data may vary, so normalize them before scoring.\nconst normalize = (value) => {\n  if (!value) return 0;\n  if (typeof value === 'number') return value;\n  const asNumber = Number(value);\n  return Number.isFinite(asNumber) ? asNumber : 0;\n};\n\nconst coverages = cvs.map((cv) => ({\n  ...cv,\n  score: normalize(cv.score)\n}));\nconst projectMatches = projects.map((project) => ({\n  ...project,\n  score: normalize(project.score)\n}));\n\nconst total = coverages.length + projectMatches.length;\nconst overallCoverage = total ? ((coverages.reduce((sum, item) => sum + normalize(item.score), 0) + projectMatches.reduce((sum, item) => sum + normalize(item.score), 0)) / total) : 0;\n\nreturn {\n  json: {\n    tender_title: tender.title || '',\n    overall_coverage_score: Number(overallCoverage.toFixed(2)),\n    proposal_brief: `We have ${coverages.length} CV matches and ${projectMatches.length} project matches.`,\n    cv_matches: coverages,\n    project_matches: projectMatches\n  }\n};\n"
      },
